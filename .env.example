# INFNITY storefront + back office — environment variables.
# Copy to .env.local for development. NEVER commit real values.
# Everything is optional for local development (PGlite + imported catalogue).
# Production needs at least DATABASE_URL and APP_SECRET.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://infinityclo.ca
# Set to true on staging/previews so search engines do not index them.
# NEXT_PUBLIC_NOINDEX=true

# --- Security & data ----------------------------------------------------------
# 32+ random characters; seals customer session cookies and hashes IPs.
# APP_SECRET=
# PostgreSQL (e.g. Neon via Vercel). Unset = local in-process PGlite (not durable).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# PGLITE_DATA_DIR=.data/pglite

# --- First back-office owner (remove after first sign-in) ---------------------
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Shopify (system of record) -----------------------------------------------
SHOPIFY_STORE_DOMAIN=apparelinifinty85.myshopify.com
# SHOPIFY_API_VERSION=2026-10
# Storefront API (Headless channel). Public token, or a private one:
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Admin API (custom app; server only). Scopes listed in docs/launch-checklist.md.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# The custom app's client secret, used to verify webhook HMACs.
# SHOPIFY_WEBHOOK_SECRET=
# Customer Account API (Headless → Customer Account API settings).
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Where "Sign in" goes before the Customer Account API is configured.
# SHOPIFY_HOSTED_ACCOUNT_URL=https://apparelinifinty85.myshopify.com/account
# SHOPIFY_DEFAULT_COUNTRY=CA

# --- Checkout hand-off ----------------------------------------------------------
# Unset = automatic: Storefront Cart API when a Storefront token exists, else disabled.
# permalink = hand off to the live Shopify checkout via cart permalinks (no token needed).
# CHECKOUT_MODE=

# --- App email (newsletter confirmation, staff notifications) ------------------
# RESEND_API_KEY=
# EMAIL_FROM="INFNITY <hello@infinityclo.ca>"

# --- Build-time importers ------------------------------------------------------------
# LEGACY_ORIGIN=https://infinityclo.ca
# SKIP_LEGACY_IMPORT=true
