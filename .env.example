# All variables are OPTIONAL. The storefront builds and runs with none of them.

# Canonical URL for metadata, OpenGraph and the sitemap.
# Set this per environment so preview deployments do not claim production URLs.
NEXT_PUBLIC_SITE_URL=https://infinityclo.ca

# Enables the checkout control and removes the preview disclosure banner.
# LEAVE THIS UNSET until a real payment provider is integrated. Setting it early
# produces a storefront that appears able to take an order it cannot take.
# NEXT_PUBLIC_CHECKOUT_ENABLED=true

# Build-time only, read by `npm run import:legacy`. Not used by the application.
# LEGACY_ORIGIN=https://infinityclo.ca
