# INFNITY — environment variables
#
# Copy to .env.local for development. Never commit real values.
# With none of these set, `npm run dev` still works: it uses an embedded
# development database and checkout stays closed.

# --- Environment -----------------------------------------------------------
# development | staging | production. Inferred on Vercel when unset.
# APP_ENV=development

# Public origin of this deployment. Used in emails, canonical URLs, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required outside development) -------------------------------
# PostgreSQL connection string. Development falls back to ./.data when unset.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Payments (Stripe) ------------------------------------------------------
# Test keys on development and staging; live keys only on production.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Development only: simulated payments, no card network. Ignored in production.
# PAYMENTS_PROVIDER=test

# --- Sessions and the admin owner account ----------------------------------
# Created for you by:  npm run admin:setup -- you@example.com
# SESSION_SECRET=
# ADMIN_OWNER_EMAIL=
# ADMIN_OWNER_PASSWORD_HASH=

# --- Email (Resend) ---------------------------------------------------------
# Without these, development prints emails to the terminal; production sends none.
# RESEND_API_KEY=
# EMAIL_FROM="INFNITY <orders@your-verified-domain>"
# CONTACT_TO_EMAIL=

# --- Scheduled maintenance ---------------------------------------------------
# Bearer token for GET /api/cron/maintenance (release expired stock holds).
# CRON_SECRET=

# --- Switches ----------------------------------------------------------------
# Set to false for a browse-only deployment.
# NEXT_PUBLIC_CHECKOUT_ENABLED=true
